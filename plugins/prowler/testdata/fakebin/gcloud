#!/bin/sh
# Fake gcloud for the tests. State lives in $FAKE_DIR:
#   accounts.json              what `auth list --format=json` prints
#   notoken/<account>          `auth print-access-token` fails for it (expired login)
#   projects/<account>.json    what `projects list` prints for it
#   profile/<project>/services.json   what `services list --enabled` prints (missing: the call fails)
#   profile/<project>/billing.json    what `billing projects describe` prints (missing: the call fails)
#   profile/<project>/<group>.json    what `<group> ... list` prints, by the command's first word
#                                     (compute, container, sql, run, functions, storage); missing: []
#   profile/<project>/deny-<group>    that list fails with a 403
set -eu
echo "gcloud $*" >> "$FAKE_DIR/calls.log"
account="" project=""
for a in "$@"; do
  case "$a" in
    --account=*) account="${a#--account=}" ;;
    --project=*) project="${a#--project=}" ;;
  esac
done
profile="$FAKE_DIR/profile/$project"
from() {  # print $1 or fail like gcloud does when it is missing
  if [ -e "$1" ]; then cat "$1"; else echo "ERROR: (gcloud) fake has no $1" >&2; exit 1; fi
}
case "$1 $2" in
  "auth list") cat "$FAKE_DIR/accounts.json" ;;
  "auth print-access-token")
    if [ -e "$FAKE_DIR/notoken/$account" ]; then
      echo "ERROR: (gcloud.auth.print-access-token) Reauthentication failed. Please run: gcloud auth login $account" >&2
      exit 1
    fi
    echo "ya29.TEST-not-a-real-token-for-$account" ;;
  "projects list") cat "$FAKE_DIR/projects/$account.json" ;;
  "services list") from "$profile/services.json" ;;
  "billing projects") profile="$FAKE_DIR/profile/$4"; from "$profile/billing.json" ;;
  "compute instances"|"container clusters"|"sql instances"|"run services"|"functions list"|"storage buckets")
    if [ -e "$profile/deny-$1" ]; then
      echo "ERROR: (gcloud.$1) PERMISSION_DENIED: caller does not have permission" >&2; exit 1
    fi
    if [ -e "$profile/$1.json" ]; then cat "$profile/$1.json"; else echo "[]"; fi ;;
  *) echo "fake gcloud: unexpected command: $*" >&2; exit 2 ;;
esac
