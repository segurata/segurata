class Gcloud:
    """Read-only gcloud calls, each with --account so the gcloud config never changes."""

    def __init__(self, path):
        self.path = path
        self.env = dict(os.environ, CLOUDSDK_CORE_DISABLE_PROMPTS="1")

    def run(self, *args):
        if not any(args[:len(c)] == c for c in READ_COMMANDS):
            raise ValueError("gcloud %s is not a read command this connector may run" % " ".join(args[:3]))
        try:
            p = subprocess.run([self.path, *args], capture_output=True, text=True, env=self.env,
                               timeout=GCLOUD_TIMEOUT, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return 1, "", "gcloud timed out after %d s" % GCLOUD_TIMEOUT
        return p.returncode, p.stdout, p.stderr

    def accounts(self):
        return [a["account"] for a in self.read_json(None, "auth", "list") or [] if a.get("account")]

    def token(self, account):
        code, out, err = self.run("auth", "print-access-token", "--account=" + account)
        token = out.strip()
        if code != 0 or not token:
            raise RuntimeError(first_line(err) or "gcloud printed no token")
        return token

    def projects(self, account):
        """{active project id: whether it has a parent}; folders exist only under an organization."""
        rows = self.read_json(account, "projects", "list", "--filter=lifecycleState:ACTIVE")
        return {p["projectId"]: bool((p.get("parent") or {}).get("type")) for p in rows or [] if p.get("projectId")}

    def read_json(self, account, *args):
        """Parsed output of a read, retried once when Google throttled or dropped it."""
        args += (("--account=" + account,) if account else ()) + ("--format=json",)
        code, out, err = self.run(*args)
        if code != 0 and TRANSIENT.search(err):
            time.sleep(RETRY_DELAY)
            code, out, err = self.run(*args)
        if code != 0:
            raise RuntimeError(first_line(err) or "gcloud %s failed" % " ".join(a for a in args[:3] if a[:1] != "-"))
        return json.loads(out or "null")

    def enabled_services(self, account, project):
        rows = self.read_json(account, "services", "list", "--enabled", "--project=" + project)
        return {(r.get("config") or {}).get("name") or (r.get("name") or "").rsplit("/", 1)[-1] for r in rows or []}

    def billing_enabled(self, account, project):
        return bool((self.read_json(account, "billing", "projects", "describe", project) or {}).get("billingEnabled"))

    def count(self, account, project, command):
        return len(self.read_json(account, *command, "--project=" + project) or [])


def first_line(text):
    for line in (text or "").splitlines():
        line = line.strip()
        if line:
            return line[:300]
    return ""


def last_error(text):
    lines = [l.strip() for l in text.splitlines() if "ERROR" in l or "CRITICAL" in l or "Error" in l]
    return one_line(lines[-1] if lines else first_line(text) or "no output")


def is_service_account(account):
