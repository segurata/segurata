# --- activity profile ------------------------------------------------------------------------

TRANSIENT = re.compile(r"RESOURCE_EXHAUSTED|rateLimitExceeded|[Qq]uota exceeded|\b429\b|\b50[23]\b|UNAVAILABLE|"
                       r"DEADLINE_EXCEEDED|timed out|Connection reset")
SERVICE_DISABLED = re.compile(r"SERVICE_DISABLED|has not been used in project|is disabled")


def profile_project(gcloud, account, project, in_org, log=lambda msg: None):
    """What the project runs, read as account. A value that could not be read is None, named in
    unread and logged with gcloud's reason; classify_profile treats it as possibly production."""
    profile = {"services_enabled": None, "services_non_default": None, "billing_enabled": None,
               "in_organization": in_org, "resources": {}, "unread": []}

    def unread(what, error):
        profile["unread"].append(what)
        log("%s: profile could not read %s as %s: %s" % (project, what, account, error))

    try:
        services = gcloud.enabled_services(account, project)
        profile["services_enabled"] = len(services)
        profile["services_non_default"] = len(services - DEFAULT_SERVICES)
    except (RuntimeError, ValueError) as e:
        services = None
        unread("services", e)
    try:
        profile["billing_enabled"] = gcloud.billing_enabled(account, project)
    except (RuntimeError, ValueError) as e:
        unread("billing", e)
    for key, enabling, command, _ in RESOURCE_KINDS:
        if services is not None and not services.intersection(enabling):
            profile["resources"][key] = 0
            continue
        try:
            profile["resources"][key] = gcloud.count(account, project, command)
        except (RuntimeError, ValueError) as e:
            if isinstance(e, RuntimeError) and SERVICE_DISABLED.search(str(e)):
                profile["resources"][key] = 0
            else:
                profile["resources"][key] = None
                unread(key, e)
    profile["class"] = classify_profile(profile)
    return profile


def classify_profile(profile):
    """'production', 'light', 'empty', or 'unknown' when what was not read could change the answer.

    production: a VM, GKE cluster, Cloud SQL instance, Cloud Run service or function, or billing on
    with any counted resource. empty: no counted resource and at most EMPTY_MAX_SERVICES services
    beyond Google's defaults. light: everything else."""
    res = profile["resources"]
    workloads = [k for k, _, _, runs in RESOURCE_KINDS if runs]
    if any(res.get(k) for k in workloads):
        return "production"
    if profile["services_non_default"] is None or any(res.get(k) is None for k, _, _, _ in RESOURCE_KINDS):
        return "unknown"
    if any(res.values()):
        if profile["billing_enabled"] is None:
            return "unknown"
        return "production" if profile["billing_enabled"] else "light"
    return "empty" if profile["services_non_default"] <= EMPTY_MAX_SERVICES else "light"


def profile_text(profile):
    """The profile for the project's status line, e.g. 'light: 25 non-default services, 2 buckets, billing off'."""
    parts = []
    if profile["services_non_default"] is not None:
        parts.append("%d non-default services" % profile["services_non_default"])
    for key, count in profile["resources"].items():
        if count:
            parts.append("%d %s" % (count, key.replace("_", " ")))
    if profile["billing_enabled"] is not None:
        parts.append("billing " + ("on" if profile["billing_enabled"] else "off"))
    if profile["unread"]:
        parts.append("not read: " + ", ".join(profile["unread"]))
    return profile["class"] + (": " + ", ".join(parts) if parts else "")


UNKNOWN_PROFILE = {"class": "unknown", "services_enabled": None, "services_non_default": None,
