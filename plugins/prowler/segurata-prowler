class Gcloud:
    """Read-only gcloud calls. --account is passed on every call so gcloud config never changes."""

    def __init__(self, path):
        self.path = path
        self.env = dict(os.environ, CLOUDSDK_CORE_DISABLE_PROMPTS="1")

    def run(self, *args):
        if not any(args[:len(c)] == c for c in READ_COMMANDS):
            raise ValueError("gcloud %s is not a read command this connector may run" % " ".join(args[:3]))
        try:
            p = subprocess.run([self.path, *args], capture_output=True, text=True, env=self.env,
                               timeout=GCLOUD_TIMEOUT, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return 1, "", "gcloud timed out after %d s" % GCLOUD_TIMEOUT
        return p.returncode, p.stdout, p.stderr

    def accounts(self):
        code, out, err = self.run("auth", "list", "--format=json")
        if code != 0:
            raise RuntimeError(first_line(err) or "gcloud auth list failed")
        return [a.get("account", "") for a in json.loads(out or "[]") if a.get("account")]

    def token(self, account):
        """An access token for account, or raises RuntimeError with gcloud's reason. Never logged."""
        code, out, err = self.run("auth", "print-access-token", "--account=" + account)
        token = out.strip()
        if code != 0 or not token:
            raise RuntimeError(first_line(err) or "gcloud printed no token")
        return token

    def projects(self, account):
        """{project id: whether it sits in an organization} for the active projects account lists.
        A project in a folder is in an organization too: folders exist only under one."""
        code, out, err = self.run("projects", "list", "--account=" + account,
                                  "--filter=lifecycleState:ACTIVE", "--format=json")
        if code != 0:
            raise RuntimeError(first_line(err) or "gcloud projects list failed")
        return {p["projectId"]: bool((p.get("parent") or {}).get("type"))
                for p in json.loads(out or "[]") if p.get("projectId")}

    def read_json(self, account, *args):
        code, out, err = self.run(*args, "--account=" + account, "--format=json")
        if code != 0 and TRANSIENT.search(err):
            time.sleep(RETRY_DELAY)
            code, out, err = self.run(*args, "--account=" + account, "--format=json")
        if code != 0:
            raise RuntimeError(first_line(err) or "gcloud %s failed" % " ".join(args[:3]))
        return json.loads(out or "null")

    def enabled_services(self, account, project):
        rows = self.read_json(account, "services", "list", "--enabled", "--project=" + project)
        return {(r.get("config") or {}).get("name") or (r.get("name") or "").rsplit("/", 1)[-1] for r in rows or []}

    def billing_enabled(self, account, project):
        return bool((self.read_json(account, "billing", "projects", "describe", project) or {}).get("billingEnabled"))

    def count(self, account, project, command):
        return len(self.read_json(account, *command, "--project=" + project) or [])


def first_line(text):
    for line in (text or "").splitlines():
        line = line.strip()
        if line:
            return line[:300]
    return ""


def is_service_account(account):
